# Build output
build/
out/
bin/
target/
!gradle/wrapper/gradle-wrapper.jar
.gradle/
!**/src/**/build/
!**/src/**/bin/

# Node (web/)
node_modules/
.next/
.turbo/

# Terraform (infra/)
.terraform/
*.tfstate
*.tfstate.*
